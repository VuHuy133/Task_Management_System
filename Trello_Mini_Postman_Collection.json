{
  "info": {
    "name": "Trello Mini API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "<SESSION_ID>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/admin",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["admin"]
        }
      }
    },
    {
      "name": "Get Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <JWT_TOKEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/admin/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "admin", "users"]
        }
      }
    },
    {
      "name": "Delete User",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <JWT_TOKEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/admin/users/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "admin", "users", ":id"]
        }
      }
    },
    {
      "name": "Get Tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <JWT_TOKEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/admin/tasks",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "admin", "tasks"]
        }
      }
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <JWT_TOKEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/admin/tasks/:id",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "admin", "tasks", ":id"]
        }
      }
    },
    {
      "name": "Get Projects",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer <JWT_TOKEN>",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/admin/projects",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "admin", "projects"]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["login"]
        }
      }
    }
  ]
}