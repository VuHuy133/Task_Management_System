# JWT Configuration
# JWT_SECRET must be at least 32 characters for HS256 signing
# Example: TrelloMiniSecretKey1234567890Trello
JWT_SECRET=your_jwt_secret
# JWT expiration in seconds (default: 86400 = 1 day)
JWT_EXPIRATION=86400

# OAuth2 Google Login Configuration
# Get credentials from: https://console.cloud.google.com/
# Steps:
#   1. Create new OAuth2 Web Application credential
#   2. Add redirect URI: http://localhost:8088/login/oauth2/code/google
#   3. Copy Client ID and Secret below
# NOTE: These are REQUIRED for OAuth2 Google login to work
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=trello
DB_USERNAME=db_username
DB_PASSWORD=db_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Spring Configuration
SPRING_PROFILES_ACTIVE=docker

# Startup Runner Configuration (disabled by default)
# Set to "true" to enable DataSeederService and ApplicationStartupRunner
# This allows automatic reset password or seeding data when application starts
APP_STARTUP_ENABLED=false

# Reset Password Configuration (only works if APP_STARTUP_ENABLED=true)
# Set to "true" to reset all user passwords to RESET_PASSWORD_VALUE when application starts
RESET_PASSWORD=false

# New password value for all users when RESET_PASSWORD=true and APP_STARTUP_ENABLED=true
# Default: 123456
RESET_PASSWORD_VALUE=123456

# --- Usage Examples ---
# To reset all passwords on next Docker start:
#   APP_STARTUP_ENABLED=true RESET_PASSWORD=true docker-compose up -d
#
# To reset all passwords to custom value:
#   APP_STARTUP_ENABLED=true RESET_PASSWORD=true RESET_PASSWORD_VALUE=customPassword docker-compose up -d
#
# To disable (default, recommended for production):
#   docker-compose up -d
